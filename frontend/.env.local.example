# Copy to .env.local and edit. Do not commit .env.local.
#
#   cp .env.local.example .env.local

# Data source.
#   true   render the shared contract fixtures from public/fixtures/ (default)
#   false  call the live FastAPI backend
#
# Flipping this switches the whole application without touching a component — that is the
# Phase 1 integration gate (ARCHITECTURE.md section 100). The backend now serves real engine
# output, so `false` is the interesting setting.
NEXT_PUBLIC_USE_MOCKS=false

# Where the backend lives. Start it with:
#   cd backend && .venv/bin/python -m uvicorn app.main:app --reload
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
