# Copy to .env and fill in. `.env` is gitignored; never commit real credentials.
#
#   cp .env.example .env

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./continuity.db

# Browser origins allowed to call the API, comma-separated. Ports 3000 and 3001 are covered by
# default. Set this if you run the frontend anywhere else — a missing origin fails in the browser
# with a CORS error and leaves nothing in the backend log, which is a slow thing to diagnose.
# CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Seed automatically when the database is empty, so `uvicorn app.main:app` is a one-command start.
AUTO_SEED=true

# The clock freshness is judged against. Fixed so a seeded demo cannot age into different
# classifications between now and judging.
REFERENCE_DATE=2026-08-15

# --- Extraction provider ---------------------------------------------------------------
#   deterministic  offline, reproducible, no credential. The default.
#   watsonx        calls IBM watsonx.ai per artifact. Needs the credentials below.
#   cached         replays committed model output from data/extraction/. Needs full coverage.
#   openrouter     rule-based extraction; a model writes the three narrative fields instead.
#                  Needs the credentials below. See docs/DECISIONS.md DEC-15.
AI_PROVIDER=deterministic

# --- IBM watsonx.ai --------------------------------------------------------------------
# Get these from the watsonx project. Mind the plan limits: the account this was developed
# against allowed 2 requests/second and a capped token quota, which is not enough to extract a
# 640-artifact corpus in one pass. `scripts.extract_with_provider` paces itself and resumes from
# the cache, so a run can be completed across several quota windows.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_REQUESTS_PER_SECOND=2

# --- OpenRouter --------------------------------------------------------------------------
# An OpenAI-compatible gateway. Used the other way round from watsonx: extraction stays
# deterministic and the model writes only the simulation summary, candidate strengths/gaps, and
# mitigation plan text — each validated (app/ai/validation.py) before it can be returned, with a
# deterministic-template fallback on any rejection or failure.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Narrative latency budget ----------------------------------------------------------
# The wall-clock ceiling on the narration phase of one request, against AC-14's 12 seconds for an
# AI explanation operation. Enforced by app/ai/budget.py rather than by the HTTP timeout above:
# httpx bounds the gap between socket reads, not total generation, so the transport timeout does
# not bound a call that keeps the socket warm (docs/DECISIONS.md DEC-18).
#
# Narratives run concurrently under this one deadline. Anything that misses it is answered from the
# deterministic template, so a slow model costs wording rather than the response. Set to 0 to skip
# model narration entirely and always use the templates — useful for demonstrating on a bad
# connection. Only affects the model-backed providers.
NARRATIVE_DEADLINE_SECONDS=8
NARRATIVE_MAX_WORKERS=3

# --- Optional API authentication -------------------------------------------------------
# Empty leaves /api/v1 open, which is the local default and what the frontend expects.
# Set it before exposing the API beyond localhost.
API_TOKEN=
